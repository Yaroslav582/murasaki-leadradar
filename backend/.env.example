# ── Core ────────────────────────────────────────────────────────────────────
APP_NAME=LeadRadar
DEBUG=false

# ── База данных ────────────────────────────────────────────────────────────────
# 1. Supabase PostgreSQL (Production / Render, порт 6543 — Transaction Pooler):
#    Поддерживаются стандартные URI из Supabase (statement_cache_size=0 настраивается автоматически):
# DATABASE_URL=postgresql+asyncpg://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?sslmode=require
#    или Session Pooler (порт 5432):
# DATABASE_URL=postgresql+asyncpg://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres?sslmode=require
#
# 2. Локальная SQLite база для разработки (по умолчанию):
# DATABASE_URL=sqlite+aiosqlite:///./data/parser.db

# Redis + Celery (USE_CELERY=true в продакшене)
REDIS_URL=redis://localhost:6379/0
USE_CELERY=false

# Наполнить базу демо-лидами при первом запуске
SEED_ON_START=true

CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Публичный адрес API — используется в ссылках на демо (/demo/{uuid}) и аутрич-сообщениях
# Локально: http://127.0.0.1:8000
# Продакшн (Render/Vercel/кастомный домен): https://murasaki-leadradar-backend.onrender.com
PUBLIC_BASE_URL=http://127.0.0.1:8000

# ── Источники данных ───────────────────────────────────────────────────────
# Google Places API (New): НЕ поддерживает российский биллинг.
# Включайте, только если есть зарубежный billing-аккаунт.
GOOGLE_PLACES_API_KEY=
# 2GIS Catalog API: https://dev.2gis.ru (бесплатный ключ на 1000 запросов/день)
TWOGIS_API_KEY=
# Яндекс Геопоиск API: https://developer.tech.yandex.ru/services (нужен тариф)
YANDEX_MAPS_API_KEY=
# ВКонтакте: бесплатный сервисный ключ на dev.vk.com -> Создать приложение -> Настройки
VK_ACCESS_TOKEN=
# Бесплатные источники без ключей:
# - yandex_web: быстрый сбор Яндекс Карт без ключей и браузера
# - osm: OpenStreetMap (Overpass + Nominatim)
# - zoon: каталог заведений и сферы услуг
# Резидентский прокси для скрапера: http://user:pass@host:port
PROXY_URL=

# ── AI Router & Multi-Provider Fallbacks ──────────────────────────────────
# Мульти-провайдерный маршрутизатор нейросетей (Groq, Gemini, OpenRouter, MXR).
# Если ключ не задан, провайдер автоматически пропускается в цепочке.
GEMINI_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=
# Резервный провайдер (платный MXR или любой совместимый OpenAI-эндпоинт):
MXR_API_KEY=
MXR_BASE_URL=https://mxr.one/v1
# Опциональный прокси для зарубежных LLM API (если сервер в РФ):
AI_PROXY_URL=
# Предохранитель от слива токенов (макс. запросов в сутки):
MAX_DAILY_LLM_CALLS=400

# --- ТЕКСТ И JSON ДЛЯ ЛЕНДИНГОВ (Текстовые модели) ---
# Порядок: сверхбыстрый Groq -> бесплатные OpenRouter -> Google AI Studio
TEXT_MODELS_CHAIN=groq:openai/gpt-oss-120b,groq:qwen/qwen3.8-27b,openrouter:baidu/ernie-5.5-flash-preview:free,openrouter:nvidia/nemotron-3.5-lightning:free,openrouter:nvidia/nemotron-3-ultra:free,openrouter:cohere/north-mini-code:free,groq:openai/gpt-oss-20b,openrouter:perplexity/decider-v1.3:free,gemini:gemini-3.8-flash,gemini:gemini-3.6-flash,gemini:gemini-4-hydrogen,gemini:gemini-3.5-flash-lite

# --- СОРТИРОВКА ФОТО (Только мультимодальные Vision-модели) ---
# Порядок: бесплатные Vision на OpenRouter -> жирный лимит AI Studio (500 RPD)
VISION_MODELS_CHAIN=openrouter:nvidia/nemotron-3.5-super-vl:free,openrouter:inclusionai/ling-3.2-flash:free,openrouter:thinkingmachines/inkling-2-small:free,gemini:gemini-3.5-flash-lite,gemini:gemini-3.8-flash

# Устаревшие переменные (поддерживаются для обратной совместимости):
LLM_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_BASE_URL=https://mxr.one/v1
OPENAI_MODEL=gpt-6-sol
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-latest

# ── Производительность ─────────────────────────────────────────────────────
HTTP_TIMEOUT=12
ENRICHMENT_CONCURRENCY=8
MAX_PARSE_LIMIT=500

# ── Telegram UserBot & Freelance Automation ────────────────────────────────
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_PHONE=
# Сессия Telethon хранится в Supabase (tg_accounts.session_string), но также может быть задана здесь:
TELEGRAM_SESSION_STRING=
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_PORTFOLIO_URL=https://murasaki-portfolio.vercel.app/

# ── TGStat Collector & Safe Joiner Worker ──────────────────────────────────
# Официальный токен TGStat API (https://api.tgstat.ru) для автоматического поиска чатов
TGSTAT_TOKEN=
# Настройки прогрева и лимитов для воркера безопасного вступления:
# worker_accounts берутся из Supabase, сессии инициализируются по StringSession
# Воркер соблюдает ночной режим по МСК (01:00-08:00) и 3 стадии прогрева:
#  - Стадия 1 (1-7 дней): 4 вступления/сутки, пауза 2-4ч
#  - Стадия 2 (8-21 день): 10 вступлений/сутки, пауза 45-90мин
#  - Стадия 3 (21+ день): 18 вступлений/сутки, пауза 30-60мин

# ── Автономный фоновый аутрич (Outreach Userbot Worker) ────────────────────
OUTREACH_ENABLED=false
OUTREACH_SESSION_STRING=
OUTREACH_WORK_HOURS_START=11
OUTREACH_WORK_HOURS_END=18
OUTREACH_DAILY_LIMIT=12
OUTREACH_MIN_DELAY_MIN=15
OUTREACH_MAX_DELAY_MIN=40
OUTREACH_TARGET_QUERIES="Салон красоты Новороссийск,Автосервис Новороссийск,Кофейня Краснодар"


