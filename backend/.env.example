# ── Core ────────────────────────────────────────────────────────────────────
APP_NAME=LeadRadar
DEBUG=false

# SQLite по умолчанию (файл в backend/data/parser.db).
# Для production используйте PostgreSQL:
# DATABASE_URL=postgresql+asyncpg://leadradar:leadradar@localhost:5432/leadradar
# DATABASE_URL=sqlite+aiosqlite:///./data/parser.db

# Redis + Celery (USE_CELERY=true в продакшене)
REDIS_URL=redis://localhost:6379/0
USE_CELERY=false

# Наполнить базу демо-лидами при первом запуске
SEED_ON_START=true

CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Публичный адрес API — используется в ссылках на демо и аутрич-сообщениях
PUBLIC_BASE_URL=http://127.0.0.1:8000

# ── Источники данных ───────────────────────────────────────────────────────
# Google Places API (New): НЕ поддерживает российский биллинг.
# Включайте, только если есть зарубежный billing-аккаунт.
GOOGLE_PLACES_API_KEY=
# 2GIS Catalog API: https://dev.2gis.ru (бесплатный ключ на 1000 запросов/день)
TWOGIS_API_KEY=
# Яндекс Геопоиск API: https://developer.tech.yandex.ru/services (нужен тариф)
YANDEX_MAPS_API_KEY=
# ВКонтакте: бесплатный сервисный ключ на dev.vk.com -> Создать приложение -> Настройки
VK_ACCESS_TOKEN=
# Бесплатные источники без ключей:
# - yandex_web: быстрый сбор Яндекс Карт без ключей и браузера
# - osm: OpenStreetMap (Overpass + Nominatim)
# - zoon: каталог заведений и сферы услуг
# Резидентский прокси для скрапера: http://user:pass@host:port
PROXY_URL=

# ── AI-генерация ───────────────────────────────────────────────────────────
# mock — встроенный шаблонный генератор (без ключей, мгновенно)
# openai / anthropic — реальная LLM для лендинга и сообщений
LLM_PROVIDER=mock
OPENAI_API_KEY=
# Для любых совместимых сетей (OpenRouter, DeepSeek, Groq, ProxyAPI, VseGPT):
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_BASE_URL=https://openrouter.ai/api/v1
# OPENAI_BASE_URL=https://api.deepseek.com
OPENAI_BASE_URL=
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-latest

# ── Производительность ─────────────────────────────────────────────────────
HTTP_TIMEOUT=12
ENRICHMENT_CONCURRENCY=8
MAX_PARSE_LIMIT=500
